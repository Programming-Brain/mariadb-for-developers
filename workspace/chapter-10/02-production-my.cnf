[mariadb]
# Memory: ~75% of 16 GB for the buffer pool
innodb_buffer_pool_size = 12G

# Write throughput: room for bursts of inserts and updates
innodb_log_file_size = 2G

# Full durability (the default, stated explicitly)
innodb_flush_log_at_trx_commit = 1

# Connections: two app servers x 100 pooled connections + slack
max_connections = 250

# Observability (from Chapter 9)
performance_schema = ON

# Recovery and replication (later in this chapter)
log_bin = mariadb-bin

# I/O: increase I/O operations per second
innodb_io_capacity = 2000
